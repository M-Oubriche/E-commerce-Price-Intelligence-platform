# .env.example

# SCRAPER CONFIG
# -----------------------------------------------------------------
SCRAPER_OUTPUT_DIR=/data/raw
SCRAPER_LOG_LEVEL=INFO

# Currency conversion API
# Get your free key at: https://exchangerate-api.com
EXCHANGE_RATE_API_KEY=your-api-key-here
EXCHANGE_RATE_API_URL=https://v6.exchangerate-api.com/v6


# POSTGRESQL
# Airflow uses these to create and connect to its metadata database
# -----------------------------------------------------------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=airflow


# AIRFLOW SECURITY KEYS
# Fernet Key — encrypts secrets stored in the Airflow metadata DB
# Generate with:
#   python -c "import base64; import os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# -----------------------------------------------------------------
AIRFLOW_FERNET_KEY=CHANGE_ME

# Secret Key — secures Airflow webserver session cookies
# Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=CHANGE_ME


# AIRFLOW ADMIN USER
# Created automatically on first run by airflow-init
# Used to log in at http://localhost:8081
# -----------------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME